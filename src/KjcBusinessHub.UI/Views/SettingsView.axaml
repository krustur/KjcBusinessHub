<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KjcBusinessHub.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="KjcBusinessHub.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="0" Spacing="20">
            <Border Classes="sectionCard">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Configure your source document folder" Classes="sectionTitle" />
                        <TextBlock Text="Choose the folder that contains the transaction export file and the source documents you reconcile each month."
                                   Classes="sectionCaption"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Classes="badge badgeSuccess"
                            VerticalAlignment="Top"
                            IsVisible="{Binding CanNavigate}">
                        <TextBlock Text="Ready" Classes="badgeText" />
                    </Border>
                </Grid>
            </Border>

            <Border Classes="sectionCard">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Source document folder *" FontWeight="SemiBold" />
                        <TextBlock Text="Use a local folder so the app can import files, watch for changes, and open documents directly."
                                   Classes="sectionCaption"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SourceDocumentFolder}"
                                 PlaceholderText="Select or enter the folder path" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Classes="secondaryAction"
                                Click="BrowseFolder" />
                    </Grid>

                    <Border Background="{Binding FeedbackTone, Converter={x:Static vm:Converters.StatusToneBackground}}"
                            BorderBrush="{Binding FeedbackTone, Converter={x:Static vm:Converters.StatusToneBorder}}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            IsVisible="{Binding HasFeedbackMessage}">
                        <TextBlock Text="{Binding FeedbackMessage}" TextWrapping="Wrap" />
                    </Border>

                    <Border Classes="subtleCard">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ConfigurationStatusTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConfigurationStatusDescription}"
                                       Classes="sectionCaption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Save folder"
                                Command="{Binding SaveCommand}"
                                Classes="primaryAction" />
                        <Button Content="Open matching workspace"
                                Command="{Binding GoToAppCommand}"
                                Classes="secondaryAction"
                                IsEnabled="{Binding CanNavigate}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
