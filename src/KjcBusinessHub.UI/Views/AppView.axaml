<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KjcBusinessHub.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="KjcBusinessHub.UI.Views.AppView"
             x:DataType="vm:AppViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom" />

        <!-- Main content: Unlinked top, Linked bottom -->
        <Grid Grid.Row="1" RowDefinitions="*,*">

            <!-- Top row: Unlinked transactions | Unlinked source documents -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="8,8,8,4">

                <!-- Unlinked Transactions -->
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,4,0" CornerRadius="4">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Unlinked Transactions" FontWeight="Bold" Margin="8,4" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding UnlinkedTransactions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding TransactionDate}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                   HorizontalAlignment="Right" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Unlinked Source Documents -->
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4,0,0,0" CornerRadius="4">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Unlinked Source Documents" FontWeight="Bold" Margin="8,4" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding UnlinkedSourceDocuments}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding FileNameDate}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                   HorizontalAlignment="Right" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

            </Grid>

            <!-- Bottom row: Linked pairs side by side -->
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="8,4,8,8" CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Linked Pairs" FontWeight="Bold" Margin="8,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding LinkedPairs}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkedPair">
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <!-- Transaction side -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Transaction.TransactionDate}" />
                                        <TextBlock Text="{Binding Transaction.Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Transaction.Amount, StringFormat='{}{0:N2}'}" />
                                    </StackPanel>
                                    <!-- Link indicator -->
                                    <TextBlock Grid.Column="1" Text="↔" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" />
                                    <!-- Source document side -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SourceDocument.FileNameDate}" />
                                        <TextBlock Text="{Binding SourceDocument.Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceDocument.Amount, StringFormat='{}{0:N2}'}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
