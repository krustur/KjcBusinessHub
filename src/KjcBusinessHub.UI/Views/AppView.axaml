<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KjcBusinessHub.UI.ViewModels"
             xmlns:entities="using:KjcBusinessHub.Application.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="KjcBusinessHub.UI.Views.AppView"
             x:DataType="vm:AppViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Toolbar row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,8,8,4">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="Link ↔" Command="{Binding LinkDocumentCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray" />
            <Separator />
            <TextBlock VerticalAlignment="Center" Foreground="Gray">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Transactions: {0}/{1}  Docs: {2}/{3}">
                        <Binding Path="TransactionHandledCount" />
                        <Binding Path="TransactionTotalCount" />
                        <Binding Path="SourceDocumentHandledCount" />
                        <Binding Path="SourceDocumentTotalCount" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Border Background="Green"
                    CornerRadius="4"
                    Padding="8,2"
                    IsVisible="{Binding IsMonthComplete}">
                <TextBlock Text="✓ Month complete"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="12" />
            </Border>
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom" />

        <!-- Filter row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="8,0,8,4">
            <CheckBox Content="Show all months"
                      IsChecked="{Binding ShowAllMonths}"
                      VerticalAlignment="Center" />

            <!-- Month navigation -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="◀" Command="{Binding GoToPreviousMonthCommand}" />
                <Button Content="This month" Command="{Binding GoToThisMonthCommand}" />
                <TextBlock Text="{Binding SelectedMonthLabel}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           MinWidth="120"
                           TextAlignment="Center" />
                <Button Content="▶" Command="{Binding GoToNextMonthCommand}" />
                <CheckBox Content="Include neighbouring months"
                          IsChecked="{Binding IncludeNeighbouringMonths}"
                          VerticalAlignment="Center" />
                <CheckBox Content="Sync transaction and source document month"
                          IsChecked="{Binding SyncTransactionAndSourceDocumentMonth}"
                          VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            IsVisible="{Binding UseSeparateSourceDocumentMonth}">
                    <TextBlock Text="Docs:"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <Button Content="◀" Command="{Binding GoToSourceDocumentPreviousMonthCommand}" />
                    <Button Content="This month" Command="{Binding GoToSourceDocumentThisMonthCommand}" />
                    <TextBlock Text="{Binding SelectedSourceDocumentMonthLabel}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               MinWidth="120"
                               TextAlignment="Center" />
                    <Button Content="▶" Command="{Binding GoToSourceDocumentNextMonthCommand}" />
                    <Button Content="Sync with Transaction"
                            Command="{Binding SyncSourceDocumentMonthWithTransactionCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Main content: available top, linked bottom -->
        <Grid Grid.Row="2" RowDefinitions="*,*">

            <!-- Top row: available transactions | available source documents -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="8,8,8,4">

                <!-- Available Transactions -->
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,4,0" CornerRadius="4">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Available Transactions" FontWeight="Bold" Margin="8,4" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding AvailableTransactions}"
                                 SelectedItem="{Binding SelectedAvailableTransaction}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:Transaction">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding AccountingDate}"
                                                       Foreground="Gray" Margin="0,0,4,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding TransactionDate}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                       HorizontalAlignment="Right" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="4"
                                                       Text="🔗"
                                                       Margin="8,0,0,0"
                                                       IsVisible="{Binding IsLinked}" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding LinkedSourceDocumentCount}"
                                                       Margin="4,0,0,0"
                                                       IsVisible="{Binding HasMultipleLinkedSourceDocuments}" />
                                            <!-- Handled-without-document badge -->
                                            <Border Grid.Column="6"
                                                    Background="DarkGreen"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding IsHandledWithoutDocument}">
                                                <TextBlock Text="✓ No doc needed"
                                                           FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <!-- Action buttons for transactions -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                            <Button Content="Mark as handled (no doc)"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).MarkAsHandledWithoutDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    IsVisible="{Binding IsHandledWithoutDocument, Converter={x:Static BoolConverters.Not}}" />
                                            <Button Content="Remove handled mark"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).UnmarkAsHandledWithoutDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    IsVisible="{Binding IsHandledWithoutDocument}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Available Source Documents -->
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4,0,0,0" CornerRadius="4">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="Available Source Documents" FontWeight="Bold" Margin="8,4" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding AvailableSourceDocuments}"
                                 SelectedItem="{Binding SelectedAvailableSourceDocument}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:SourceDocument">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <!-- Main info row -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding FileNameDate}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                       HorizontalAlignment="Right" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CurrencyDisplay}"
                                                       HorizontalAlignment="Right" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="4"
                                                       Text="🔗"
                                                       Margin="8,0,0,0"
                                                       IsVisible="{Binding IsLinked}" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding LinkedTransactionCount}"
                                                       Margin="4,0,0,0"
                                                       IsVisible="{Binding HasMultipleLinkedTransactions}" />
                                            <!-- Pending badge for future transactions -->
                                            <Border Grid.Column="6"
                                                    Background="SteelBlue"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding IsFutureTransaction}">
                                                <TextBlock Text="Pending"
                                                           FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                            <!-- Status badge for non-Active documents -->
                                            <Border Grid.Column="7"
                                                    Background="Orange"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding Status, Converter={x:Static vm:Converters.IsNotActive}}">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                            <!-- Annual badge -->
                                            <Border Grid.Column="8"
                                                    Background="DarkOrange"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding IsAnnual}">
                                                <TextBlock Text="Annual"
                                                           FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                            <!-- ExpiredAnnual badge -->
                                            <Border Grid.Column="9"
                                                    Background="Gray"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding IsExpiredAnnual}">
                                                <TextBlock Text="Expired Annual"
                                                           FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <!-- Action buttons row -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                            <Button Content="Open"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).OpenDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11" />
                                            <Button Content="Show in Explorer"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).ShowInExplorerCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11" />
                                            <Button Content="Set Amount"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).BeginSetAmountCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11" />
                                            <Button Content="Mark as Pending"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).MarkAsFutureTransactionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    IsVisible="{Binding IsFutureTransaction, Converter={x:Static BoolConverters.Not}}" />
                                            <Button Content="Remove Pending"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).UnmarkAsFutureTransactionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    IsVisible="{Binding IsFutureTransaction}" />
                                            <Button Content="Mark Annual"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).MarkAsAnnualCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    IsVisible="{Binding CanMarkAsAnnual}" />
                                            <Button Content="Mark Expired Annual"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).MarkAsExpiredAnnualCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    IsVisible="{Binding CanMarkAsExpiredAnnual}" />
                                            <Button Content="Clear Annual"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).ClearAnnualTypeCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    IsVisible="{Binding CanClearAnnualType}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Inline Set Amount panel -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding IsSettingAmount}"
                                BorderBrush="SteelBlue" BorderThickness="1"
                                CornerRadius="4" Margin="4" Padding="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding DocumentBeingAmounted.Description,
                                                  StringFormat='Set amount for: {0}'}"
                                           FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,*,Auto,Auto,*">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding AmountInputText}"
                                             PlaceholderText="Enter amount…" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CcyAmountInputText}"
                                             PlaceholderText="Enter currency amount…" 
                                             Margin="4,0,0,0" />
                                    <ComboBox Grid.Column="2"
                                             ItemsSource="{Binding SupportedCurrencies}"
                                             SelectedItem="{Binding SelectedCurrency}"
                                             IsEnabled="{Binding CanSelectCurrency}"
                                             Margin="4,0,0,0" />
                                    <Button Grid.Column="3" Content="Confirm"
                                            Command="{Binding ConfirmSetAmountCommand}"
                                            Margin="4,0,0,0" />
                                    <Button Grid.Column="4" Content="Cancel"
                                            Command="{Binding CancelSetAmountCommand}"
                                            Margin="4,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>

            <!-- Bottom row: Linked pairs side by side -->
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="8,4,8,8" CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Linked Pairs" FontWeight="Bold" Margin="8,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding LinkedTransactionGroups}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkedTransactionGroup">
                                <StackPanel Spacing="6" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Transaction.AccountingDate}" Foreground="Gray" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Transaction.TransactionDate}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Transaction.Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Transaction.Amount, StringFormat='{}{0:N2}'}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding LinkedDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LinkedPair">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="24,0,0,0">
                                                    <TextBlock Grid.Column="0" Text="↳" Foreground="Gray" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SourceDocument.FileNameDate}" Margin="8,0,8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SourceDocument.Description}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SourceDocument.Amount, StringFormat='{}{0:N2}'}" Margin="8,0,0,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding SourceDocument.CurrencyDisplay}" Margin="8,0,0,0" />
                                                    <Button Grid.Column="5" Content="Open"
                                                            Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).OpenDocumentCommand}"
                                                            CommandParameter="{Binding SourceDocument}"
                                                            Margin="8,0,0,0" />
                                                    <Button Grid.Column="6" Content="Show in Explorer"
                                                            Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).ShowInExplorerCommand}"
                                                            CommandParameter="{Binding SourceDocument}"
                                                            Margin="8,0,0,0" />
                                                    <Button Grid.Column="7" Content="Unlink"
                                                            Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).UnlinkDocumentCommand}"
                                                            CommandParameter="{Binding}"
                                                            Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
