<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KjcBusinessHub.UI.ViewModels"
             xmlns:entities="using:KjcBusinessHub.Application.Entities"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="KjcBusinessHub.UI.Views.AppView"
             x:DataType="vm:AppViewModel"
             x:Name="RootControl">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ── Toolbar ────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,8,8,4">
            <Button Command="{Binding RefreshCommand}" Padding="6,4" ToolTip.Tip="Refresh">
                <materialIcons:MaterialIcon Kind="Refresh" Width="27" Height="27" />
            </Button>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray" />
            <Separator />
            <TextBlock VerticalAlignment="Center" Foreground="Gray">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Transactions: {0}/{1}  Docs: {2}/{3}">
                        <Binding Path="TransactionHandledCount" />
                        <Binding Path="TransactionTotalCount" />
                        <Binding Path="SourceDocumentHandledCount" />
                        <Binding Path="SourceDocumentTotalCount" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <materialIcons:MaterialIcon Kind="CheckboxMarked"
                                        Width="30" Height="30"
                                        Foreground="Green"
                                        IsVisible="{Binding IsMonthComplete}"
                                        ToolTip.Tip="Month complete"
                                        VerticalAlignment="Center" />
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom" />

        <!-- ── Filter Panel ──────────────────────────────────────────── -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                Margin="8,0,8,4" Padding="6,4">
            <!-- View scope selector -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="View:" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                <RadioButton GroupName="ViewScope" Content="Current month"
                             IsChecked="{Binding IsCurrentMonthScope}"
                             VerticalAlignment="Center" />
                <RadioButton GroupName="ViewScope" Content="Adjacent months"
                             IsChecked="{Binding IsAdjacentMonthsScope}"
                             VerticalAlignment="Center" />
                <RadioButton GroupName="ViewScope" Content="All months"
                             IsChecked="{Binding IsAllMonthsScope}"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ── Linking Panel (always visible; highlights when both sides are selected) -->
        <Border Grid.Row="2"
                BorderBrush="SteelBlue" BorderThickness="2" CornerRadius="4"
                Margin="8,0,8,4" Padding="8,6" Background="#D6E8F8">
            <Grid ColumnDefinitions="*,Auto,*">

                <!-- Selected transaction summary -->
                <Border Grid.Column="0" Background="#EEF5FC" CornerRadius="3" Padding="6,4">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Transaction" Foreground="SteelBlue" FontSize="11" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedAvailableTransaction.AccountingDate}"
                                       Foreground="Gray" Margin="0,0,4,0" FontSize="12" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedAvailableTransaction.TransactionDate}"
                                       Margin="0,0,8,0" FontSize="12" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectedAvailableTransaction.Description}"
                                       TextTrimming="CharacterEllipsis" FontSize="12" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SelectedAvailableTransaction.Amount, StringFormat='{}{0:N2}'}"
                                       HorizontalAlignment="Right" Margin="8,0,0,0" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Link action (centre) -->
                <Button Grid.Column="1"
                        Command="{Binding LinkDocumentCommand}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="12,0"
                        Padding="14,8"
                        Background="#1A6AB0"
                        Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="LinkVariant" Width="27" Height="27" />
                        <TextBlock Text="Link" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Selected document summary -->
                <Border Grid.Column="2" Background="#EEF5FC" CornerRadius="3" Padding="6,4">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Source Document" Foreground="SteelBlue" FontSize="11" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedAvailableSourceDocument.FileNameDate}"
                                       Margin="0,0,8,0" FontSize="12" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedAvailableSourceDocument.Description}"
                                       TextTrimming="CharacterEllipsis" FontSize="12" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectedAvailableSourceDocument.Amount, StringFormat='{}{0:N2}'}"
                                       HorizontalAlignment="Right" Margin="8,0,0,0" FontSize="12" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SelectedAvailableSourceDocument.CurrencyDisplay}"
                                       Margin="4,0,0,0" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ── Set Amount Panel ──────────────────────────────────────── -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsSettingAmount}"
                BorderBrush="SteelBlue" BorderThickness="1"
                CornerRadius="4" Margin="8,0,8,4" Padding="8">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding DocumentBeingAmounted.Description,
                                  StringFormat='Set amount for: {0}'}"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*,Auto,Auto,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding AmountInputText}"
                             PlaceholderText="Amount…" />
                    <TextBox Grid.Column="1"
                             Text="{Binding CcyAmountInputText}"
                             PlaceholderText="Currency amount…"
                             Margin="4,0,0,0" />
                    <ComboBox Grid.Column="2"
                             ItemsSource="{Binding SupportedCurrencies}"
                             SelectedItem="{Binding SelectedCurrency}"
                             IsEnabled="{Binding CanSelectCurrency}"
                             Margin="4,0,0,0" />
                    <Button Grid.Column="3" Content="Confirm"
                            Command="{Binding ConfirmSetAmountCommand}"
                            Margin="4,0,0,0" />
                    <Button Grid.Column="4" Content="Cancel"
                            Command="{Binding CancelSetAmountCommand}"
                            Margin="4,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Main content ──────────────────────────────────────────── -->
        <Grid Grid.Row="4" RowDefinitions="*,*">

            <!-- Top row: available transactions | available source documents -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="8,4,8,4">

                <!-- ── Available Transactions ──────────────────── -->
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1"
                        Margin="0,0,4,0" CornerRadius="4">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <TextBlock Grid.Row="0" Text="Available Transactions"
                                   FontWeight="Bold" Margin="8,4" />

                        <!-- Transaction month selector (above the list, visible only when not in All months mode) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding IsMonthScopeVisible}"
                                    Margin="8,0,8,4">
                            <Button Command="{Binding GoToPreviousMonthCommand}" Padding="8,6"
                                    ToolTip.Tip="Previous month">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="24" Height="24" />
                            </Button>
                            <ComboBox ItemsSource="{Binding AvailableTransactionMonths}"
                                      SelectedItem="{Binding SelectedTransactionMonthOption}"
                                      MinWidth="150" FontSize="15" FontWeight="SemiBold"
                                      VerticalAlignment="Center" />
                            <Button Command="{Binding GoToNextMonthCommand}" Padding="8,6"
                                    ToolTip.Tip="Next month">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="24" Height="24" />
                            </Button>
                            <Button Command="{Binding GoToThisMonthCommand}" Padding="8,6"
                                    ToolTip.Tip="Go to this month">
                                <materialIcons:MaterialIcon Kind="Crosshairs" Width="24" Height="24" />
                            </Button>
                        </StackPanel>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding AvailableTransactions}"
                                 SelectedItem="{Binding SelectedAvailableTransaction}">

                            <!-- Context menu at list level (operates on selected item) -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Mark as handled (no document)"
                                              Command="{Binding MarkAsHandledWithoutDocumentCommand}"
                                              CommandParameter="{Binding SelectedAvailableTransaction}"
                                              IsVisible="{Binding SelectedAvailableTransaction.CanMarkAsHandledWithoutDocument}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="22" Height="22" Foreground="Teal" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Remove handled mark"
                                              Command="{Binding UnmarkAsHandledWithoutDocumentCommand}"
                                              CommandParameter="{Binding SelectedAvailableTransaction}"
                                              IsVisible="{Binding SelectedAvailableTransaction.CanRemoveHandledMark}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="22" Height="22" Foreground="Gray" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:Transaction">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding AccountingDate}"
                                                   Foreground="Gray" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding TransactionDate}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                   HorizontalAlignment="Right" Margin="8,0,0,0" />
                                        <!-- Linked badge -->
                                        <materialIcons:MaterialIcon Grid.Column="4"
                                                                    Kind="Link"
                                                                    Width="24" Height="24"
                                                                    Foreground="Green"
                                                                    Margin="6,0,0,0"
                                                                    IsVisible="{Binding IsLinked}"
                                                                    ToolTip.Tip="Linked" />
                                        <!-- Handled-without-document badge -->
                                        <materialIcons:MaterialIcon Grid.Column="5"
                                                                    Kind="CheckCircleOutline"
                                                                    Width="24" Height="24"
                                                                    Foreground="Teal"
                                                                    Margin="4,0,0,0"
                                                                    IsVisible="{Binding IsHandledWithoutDocument}"
                                                                    ToolTip.Tip="Handled without document" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ── Available Source Documents ──────────────── -->
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1"
                        Margin="4,0,0,0" CornerRadius="4">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <TextBlock Grid.Row="0" Text="Available Source Documents"
                                   FontWeight="Bold" Margin="8,4" />

                        <!-- Documents month selector (above the list, always visible when in month scope) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding IsShowDocumentsMonthSelector}"
                                    Margin="8,0,8,4">
                            <Button Command="{Binding GoToSourceDocumentPreviousMonthCommand}" Padding="8,6"
                                    IsEnabled="{Binding UseSeparateSourceDocumentMonth}"
                                    ToolTip.Tip="Previous month">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="24" Height="24" />
                            </Button>
                            <ComboBox ItemsSource="{Binding AvailableSourceDocumentMonths}"
                                      SelectedItem="{Binding SelectedSourceDocumentMonthOption}"
                                      IsEnabled="{Binding UseSeparateSourceDocumentMonth}"
                                      MinWidth="150" FontSize="15" FontWeight="SemiBold"
                                      VerticalAlignment="Center" />
                            <Button Command="{Binding GoToSourceDocumentNextMonthCommand}" Padding="8,6"
                                    IsEnabled="{Binding UseSeparateSourceDocumentMonth}"
                                    ToolTip.Tip="Next month">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="24" Height="24" />
                            </Button>
                            <Button Command="{Binding GoToSourceDocumentThisMonthCommand}" Padding="8,6"
                                    IsEnabled="{Binding UseSeparateSourceDocumentMonth}"
                                    ToolTip.Tip="Go to this month">
                                <materialIcons:MaterialIcon Kind="Crosshairs" Width="24" Height="24" />
                            </Button>
                            <!-- Sync toggle: shows whether documents follow the same month -->
                            <Button Command="{Binding ToggleSeparateDocumentMonthCommand}" Padding="8,6"
                                    ToolTip.Tip="Toggle separate document month">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="Sync" Width="24" Height="24"
                                                                IsVisible="{Binding SyncTransactionAndSourceDocumentMonth}" />
                                    <materialIcons:MaterialIcon Kind="SyncDisabled" Width="24" Height="24"
                                                                IsVisible="{Binding SyncTransactionAndSourceDocumentMonth, Converter={x:Static BoolConverters.Not}}" />
                                </Panel>
                            </Button>
                        </StackPanel>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding AvailableSourceDocuments}"
                                 SelectedItem="{Binding SelectedAvailableSourceDocument}">

                            <!-- Context menu at list level (operates on selected item) -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Change amount"
                                              Command="{Binding BeginSetAmountCommand}"
                                              CommandParameter="{Binding SelectedAvailableSourceDocument}"
                                              IsVisible="{Binding SelectedAvailableSourceDocument.HasAmount}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="CurrencyUsd" Width="22" Height="22" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Show in folder"
                                              Command="{Binding ShowInExplorerCommand}"
                                              CommandParameter="{Binding SelectedAvailableSourceDocument}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="22" Height="22" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Not annual"
                                              Command="{Binding ClearAnnualTypeCommand}"
                                              CommandParameter="{Binding SelectedAvailableSourceDocument}"
                                              IsVisible="{Binding SelectedAvailableSourceDocument.CanClearAnnualType}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="RepeatOff" Width="22" Height="22" Foreground="Gray" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Annual"
                                              Command="{Binding MarkAsAnnualCommand}"
                                              CommandParameter="{Binding SelectedAvailableSourceDocument}"
                                              IsVisible="{Binding SelectedAvailableSourceDocument.CanMarkAsAnnual}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="Repeat" Width="22" Height="22" Foreground="SteelBlue" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Expired annual"
                                              Command="{Binding MarkAsExpiredAnnualCommand}"
                                              CommandParameter="{Binding SelectedAvailableSourceDocument}"
                                              IsVisible="{Binding SelectedAvailableSourceDocument.CanMarkAsExpiredAnnual}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="CalendarRemove" Width="22" Height="22" Foreground="Gray" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Mark as Pending"
                                              Command="{Binding MarkAsFutureTransactionCommand}"
                                              CommandParameter="{Binding SelectedAvailableSourceDocument}"
                                              IsVisible="{Binding SelectedAvailableSourceDocument.IsFutureTransaction, Converter={x:Static BoolConverters.Not}}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="ClockOutline" Width="22" Height="22" Foreground="Orange" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Remove Pending"
                                              Command="{Binding UnmarkAsFutureTransactionCommand}"
                                              CommandParameter="{Binding SelectedAvailableSourceDocument}"
                                              IsVisible="{Binding SelectedAvailableSourceDocument.IsFutureTransaction}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="ClockRemoveOutline" Width="22" Height="22" Foreground="Gray" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:SourceDocument">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <!-- Main info row -->
                                        <Grid Grid.Row="0"
                                              ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding FileNameDate}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                       HorizontalAlignment="Right" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CurrencyDisplay}"
                                                       Margin="4,0,0,0" />
                                            <!-- Linked badge -->
                                            <materialIcons:MaterialIcon Grid.Column="4"
                                                                        Kind="Link"
                                                                        Width="24" Height="24"
                                                                        Foreground="Green"
                                                                        Margin="6,0,0,0"
                                                                        IsVisible="{Binding IsLinked}"
                                                                        ToolTip.Tip="Linked" />
                                            <!-- Pending badge -->
                                            <materialIcons:MaterialIcon Grid.Column="5"
                                                                        Kind="ClockOutline"
                                                                        Width="24" Height="24"
                                                                        Foreground="Orange"
                                                                        Margin="4,0,0,0"
                                                                        IsVisible="{Binding IsFutureTransaction}"
                                                                        ToolTip.Tip="Pending" />
                                            <!-- Non-Active status badge -->
                                            <materialIcons:MaterialIcon Grid.Column="6"
                                                                        Kind="AlertCircleOutline"
                                                                        Width="24" Height="24"
                                                                        Foreground="Orange"
                                                                        Margin="4,0,0,0"
                                                                        IsVisible="{Binding Status, Converter={x:Static vm:Converters.IsNotActive}}"
                                                                        ToolTip.Tip="{Binding Status}" />
                                            <!-- Annual badge -->
                                            <materialIcons:MaterialIcon Grid.Column="7"
                                                                        Kind="Repeat"
                                                                        Width="24" Height="24"
                                                                        Foreground="SteelBlue"
                                                                        Margin="4,0,0,0"
                                                                        IsVisible="{Binding IsAnnual}"
                                                                        ToolTip.Tip="Annual" />
                                            <!-- Expired Annual badge -->
                                            <materialIcons:MaterialIcon Grid.Column="8"
                                                                        Kind="CalendarRemove"
                                                                        Width="24" Height="24"
                                                                        Foreground="Gray"
                                                                        Margin="4,0,0,0"
                                                                        IsVisible="{Binding IsExpiredAnnual}"
                                                                        ToolTip.Tip="Expired annual" />
                                            <!-- Open button (inline, icon-only, always visible) -->
                                            <Button Grid.Column="9"
                                                    Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).OpenDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,2" Margin="6,0,0,0"
                                                    ToolTip.Tip="Open">
                                                <materialIcons:MaterialIcon Kind="OpenInNew"
                                                                            Width="24" Height="24" />
                                            </Button>
                                        </Grid>

                                        <!-- Inline Set Amount (only when document has no amount yet) -->
                                        <Button Grid.Row="1"
                                                Content="Set Amount"
                                                Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).BeginSetAmountCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" FontSize="11"
                                                Margin="0,2,0,0"
                                                IsVisible="{Binding HasNoAmount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

            </Grid>

            <!-- Bottom row: Linked pairs -->
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                    Margin="8,4,8,8" CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Linked Pairs"
                               FontWeight="Bold" Margin="8,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding LinkedTransactionGroups}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkedTransactionGroup">
                                <StackPanel Spacing="4" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Transaction.AccountingDate}"
                                                   Foreground="Gray" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Transaction.TransactionDate}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Transaction.Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Transaction.Amount, StringFormat='{}{0:N2}'}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding LinkedDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LinkedPair">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto"
                                                      Margin="24,0,0,0">
                                                    <TextBlock Grid.Column="0" Text="↳" Foreground="Gray" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SourceDocument.FileNameDate}"
                                                               Margin="8,0,8,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SourceDocument.Description}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding SourceDocument.Amount, StringFormat='{}{0:N2}'}"
                                                               Margin="8,0,0,0" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding SourceDocument.CurrencyDisplay}"
                                                               Margin="4,0,0,0" />
                                                    <Button Grid.Column="5" Padding="4,2" Margin="8,0,0,0"
                                                            Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).OpenDocumentCommand}"
                                                            CommandParameter="{Binding SourceDocument}"
                                                            ToolTip.Tip="Open">
                                                        <materialIcons:MaterialIcon Kind="OpenInNew"
                                                                                    Width="24" Height="24" />
                                                    </Button>
                                                    <Button Grid.Column="6" Padding="4,2" Margin="4,0,0,0"
                                                            Command="{Binding $parent[UserControl].((vm:AppViewModel)DataContext).UnlinkDocumentCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Unlink">
                                                        <materialIcons:MaterialIcon Kind="LinkOff"
                                                                                    Width="24" Height="24" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
